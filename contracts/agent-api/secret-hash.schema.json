{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcreader.internal/contracts/agent-api/secret-hash.schema.json",
  "title": "Recovery key hash",
  "description": "A salted PBKDF2-SHA256 hash of the normalized recovery key (trimmed, upper-case, without '-' and spaces), in the PC's config.json SecretHash format. One salt per key version. The key itself never leaves the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "iterations",
    "salt",
    "hash"
  ],
  "properties": {
    "algorithm": {
      "const": "pbkdf2-sha256"
    },
    "iterations": {
      "type": "integer",
      "minimum": 100000,
      "maximum": 10000000
    },
    "salt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{22}==$",
      "description": "base64 of 16 random bytes"
    },
    "hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "description": "base64 of 32 bytes"
    }
  }
}
