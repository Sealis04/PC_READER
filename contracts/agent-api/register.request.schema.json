{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcreader.internal/contracts/agent-api/register.request.schema.json",
  "title": "POST /api/agent/register request",
  "type": "object",
  "additionalProperties": false,
  "required": ["enrollment_key", "it_pin", "device_uuid", "os_type", "hostname", "hardware_summary", "user"],
  "properties": {
    "enrollment_key": { "type": "string", "minLength": 1, "maxLength": 512 },
    "it_pin": { "type": "string", "pattern": "^[0-9]{6}$", "description": "The current hourly IT PIN (shown on the dashboard)" },
    "device_uuid": { "type": "string", "format": "uuid", "description": "Generated by the agent at install and kept for the life of the install" },
    "os_type": { "enum": ["windows", "macos"] },
    "hostname": { "type": "string", "minLength": 1, "maxLength": 255 },
    "hardware_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "serial_number"],
      "properties": {
        "manufacturer": { "type": ["string", "null"], "maxLength": 255 },
        "model": { "type": ["string", "null"], "maxLength": 255 },
        "serial_number": { "type": ["string", "null"], "maxLength": 255 }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "employee_id", "email", "department", "position", "phone", "policy_acknowledged"],
      "properties": {
        "full_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "employee_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "email": { "type": ["string", "null"], "format": "email", "maxLength": 255 },
        "department": { "type": "string", "minLength": 1, "maxLength": 255 },
        "position": { "type": ["string", "null"], "maxLength": 255 },
        "phone": { "type": ["string", "null"], "maxLength": 64 },
        "policy_acknowledged": { "const": true, "description": "The user accepted the data-use notice" }
      }
    }
  }
}
