{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcreader.internal/contracts/agent-api/user.request.schema.json",
  "title": "PUT /api/agent/user request (and response body)",
  "description": "The user's details; same fields as register.request's user, without policy_acknowledged. The response returns the stored user in the same shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "full_name",
    "employee_id",
    "email",
    "department",
    "position",
    "phone"
  ],
  "properties": {
    "full_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "employee_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email",
      "maxLength": 255
    },
    "department": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "position": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "phone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    }
  }
}
