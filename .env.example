# Copy to .env (git-ignored) and change the values.
# Key IT types into `pcreader register --key ...`. Use a long random string.
ENROLLMENT_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
CHECKIN_INTERVAL_SECONDS=300
# Time zone of the dashboard, the inventory number year and the IT PIN hour (any IANA name). The agency name,
# logo and inventory prefix are set on the dashboard Settings page, not here.
DISPLAY_TIMEZONE=Asia/Manila
# Staff login with HRIS (README "Staff login (HRIS)"). Without these the dashboard shows "Login is not configured".
BETTER_AUTH_SECRET=
# This server's own public URL; the redirect URI registered in HRIS is <this>/api/auth/oauth2/callback/hris
BETTER_AUTH_URL=http://localhost:3000
HRIS_URL=
HRIS_CLIENT_ID=
HRIS_CLIENT_SECRET=
# Comma list of HRIS user levels allowed to sign in.
HRIS_ALLOWED_USER_LEVELS=IT
# Optional: secret behind the hourly IT PIN. Left empty, the server makes one and keeps it in the database.
IT_PIN_SECRET=
# Key that encrypts secret custom-field values (AES-256-GCM): 32 random bytes, base64. Generate one with
# `openssl rand -base64 32`. Without it the server still starts but secret fields are disabled.
# Back it up together with the database: a lost key means lost secrets.
SECRETS_KEY=
