# setup.bat (Windows) or ./setup.sh (Linux/macOS) writes the env file for you: .env for development,
# .env.prod for production. To do it by hand instead, copy this file to .env (git-ignored) and change the values.

# Compose project name; keeps dev (pcreader-dev) and prod (pcreader) volumes apart on one machine.
COMPOSE_PROJECT_NAME=pcreader

# Key IT types into the desktop app or `pcreader register --key ...`. Use a long random string.
ENROLLMENT_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
CHECKIN_INTERVAL_SECONDS=300
# Time zone of the dashboard, the inventory number year and the IT PIN hour (any IANA name). The agency name,
# logo and inventory prefix are set on the dashboard Settings page, not here.
DISPLAY_TIMEZONE=Asia/Manila
# Optional: secret behind the hourly IT PIN. Left empty, the server makes one and keeps it in the database.
IT_PIN_SECRET=
# Key that encrypts secret custom-field values (AES-256-GCM): 32 random bytes, base64. Generate one with
# `openssl rand -base64 32`. Without it the server still starts but secret fields are disabled.
# Back it up together with the database: a lost key means lost secrets.
SECRETS_KEY=

# Port PCs and browsers use, and the address it listens on: 0.0.0.0 = the whole LAN, 127.0.0.1 = this computer
# (and the tunnel) only.
APP_PORT=3000
APP_BIND=0.0.0.0
# Development only (compose.local.yml): the database on 127.0.0.1 for bun dev and tests.
DB_PORT=5432

# Optional Cloudflare Tunnel (docker compose --profile tunnel). PUBLIC_URL is only shown by setup.
# The dashboard has no login: put Cloudflare Access in front of it (see README).
PUBLIC_URL=
CLOUDFLARE_TUNNEL_TOKEN=
