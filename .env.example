# Copy to .env (git-ignored) and change the values.
# Key IT types into `pcreader register --key ...`. Use a long random string.
ENROLLMENT_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
CHECKIN_INTERVAL_SECONDS=300
DISPLAY_TIMEZONE=Asia/Manila
# Optional: secret behind the hourly IT PIN. Left empty, the server makes one and keeps it in the database.
IT_PIN_SECRET=
